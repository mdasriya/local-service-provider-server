# PostgreSQL connection string:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=

# Use a long, random value. Keep the real value private in .env.
SECRET_KEY=

# Change to "development" only for local testing. Unauthenticated /users access
# is still limited to loopback clients; leave this unset or use "production" when deployed.
APP_ENV=production

# SMTP settings required for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Set SMTP_USE_SSL=true for implicit TLS (typically port 465).
# Otherwise STARTTLS is used (typically port 587).
SMTP_USE_SSL=false
